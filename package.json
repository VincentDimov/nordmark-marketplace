{
  "name": "nordmark",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "format": "prettier --write src prisma tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@vercel/blob": "^2.8.2",
    "better-auth": "1.7.18",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^20.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "prettier": "^3.7.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "minimatch": "^11.0.5",
    "zod": "$zod"
  },
  "engines": {
    "node": "22.x"
  }
}
